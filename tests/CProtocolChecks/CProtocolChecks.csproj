<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep independent output roots from re-including an old local obj tree. -->
    <Compile Remove="obj/**/*.cs;bin/**/*.cs" />
    <Compile Include="../../src/Protocol/*.cs" Link="Protocol/%(Filename)%(Extension)" />
    <Compile Include="../../src/AgentBridge/EventLog.cs" Link="EventLog.cs" />
  </ItemGroup>
</Project>
